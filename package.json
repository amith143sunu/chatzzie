{
  "name": "chatzie-monorepo",
  "version": "1.0.0",
  "private": true,
  "main": "app.js",
  "workspaces": [
    "apps/*",
    "packages/*",
    "server"
  ],
  "scripts": {
    "start": "node app.js",
    "build": "echo 'Pre-built production assets ready'",
    "build:all": "npm --workspace=packages/shared run build && npm --workspace=server run build && npm --workspace=apps/web-admin run build && cd apps/mobile && HOME=/tmp EXPO_NO_TELEMETRY=1 npx expo export --platform web && node ../../scripts/optimize-mobile-html.js",
    "build:shared": "npm --workspace=packages/shared run build",
    "build:server": "npm --workspace=server run build",
    "build:admin": "npm --workspace=apps/web-admin run build",
    "build:mobile": "cd apps/mobile && HOME=/tmp EXPO_NO_TELEMETRY=1 npx expo export --platform web && node ../../scripts/optimize-mobile-html.js",
    "dev:mobile": "npm --workspace=apps/mobile run dev",
    "dev:admin": "npm --workspace=apps/web-admin run dev",
    "dev:server": "npm --workspace=server run dev"
  },
  "dependencies": {
    "agora-access-token": "^2.0.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "next": "14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io": "^4.7.5"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
