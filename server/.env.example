# Server Environment
NODE_ENV=production
PORT=8682

# Standalone PostgreSQL Database (Fresh DB instance)
DATABASE_URL=postgresql://chatzie_user:chatzie_secure_password_2026@postgres:5432/chatzie_db?schema=public

# Standalone Redis (Presence, Sockets & Rate Limiting)
REDIS_URL=redis://redis:6379

# JWT Secret for Mobile App & Admin Auth
JWT_SECRET=chatzie_brand_new_super_secret_jwt_key_2026
