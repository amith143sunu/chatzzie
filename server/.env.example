# ==========================================
# CHATZIE BRAND-NEW DEDICATED SERVER CONFIG
# ==========================================

# Server Environment
NODE_ENV=production
PORT=8682

# Standalone PostgreSQL Database (Fresh DB instance)
DATABASE_URL=postgresql://chatzie_user:chatzie_secure_password_2026@postgres:5432/chatzie_db?schema=public

# Standalone Redis (Presence, Sockets & Rate Limiting)
REDIS_URL=redis://redis:6379

# JWT Secret for Mobile App & Admin Auth
JWT_SECRET=chatzie_brand_new_super_secret_jwt_key_2026
ADMIN_SECRET_KEY=chatzie_admin_master_secret_2026

# Agora RTC Calling Engine (Fresh Project Credentials)
# Get from: https://console.agora.io
AGORA_APP_ID=your_brand_new_agora_app_id
AGORA_APP_CERTIFICATE=your_brand_new_agora_certificate

# Razorpay & RazorpayX Payouts (Fresh Merchant Keys)
# Get from: https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_live_your_brand_new_key
RAZORPAY_KEY_SECRET=your_brand_new_secret
RAZORPAYX_ACCOUNT_NUMBER=your_razorpayx_virtual_account

# SMS OTP Gateways (For real mobile verification)
# 1. Fast2SMS (Recommended for India - https://www.fast2sms.com)
FAST2SMS_API_KEY=your_fast2sms_api_key
# 2. MSG91 (DLT Route - https://msg91.com)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_template_id
# 3. Twilio (Global SMS - https://www.twilio.com)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Push Notifications (Firebase Cloud Messaging / Expo Push)
FIREBASE_PROJECT_ID=chatzie-app-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@chatzie-app-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
